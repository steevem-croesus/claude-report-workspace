# Symlinks to the real checkouts — machine-specific absolute paths, each its own git repo.
/repos/

# Ephemeral per-task working directories (see .claude/conventions/protocol.md).
/.work/

# Local benchmark/eval fixtures (ticket-specific PR diffs & metadata).
/.benchmark/

# Claude Code local, machine-specific settings (the shared settings.json is tracked).
.claude/settings.local.json

# Report-migration global mutable state (local, per-machine; the master data files
# docs/fields.csv + docs/template_ids.csv and per-report docs/reports/<RPT>/ stay tracked).
/docs/state.json

# Skills symlinked in from the monolith .claude (machine-specific links; run
# link-monolith-skills.ps1 to (re)create them). The real skills live in the monolith.
/.claude/skills/croesus-orm
/.claude/skills/create-small-tests
/.claude/skills/create-medium-tests
/.claude/skills/create-large-tests
/.claude/skills/create-internal-route
/.claude/skills/implement-full-story
/.claude/skills/croesus-process-conventions
